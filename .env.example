# © 2026 aiaiaiai · aiaiaiai.org

RAILS_ENV=development
SECRET_KEY_BASE=replace-with-at-least-64-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism_hub_development
PRISM_HUB_LEGACY_TOKEN_ENABLED=false
# PRISM_HUB_API_TOKEN=legacy-migration-token-only-when-explicitly-enabled
PRISM_HUB_CHANNELS_JSON=[{"id":"personal-threads","label":"Personal Threads","provider_id":"meta.threads","channel_ref":"0x0sky","credential_ref":"threads.personal","capabilities":{"formats":["post"],"text":true,"media_kinds":[]}}]
PRISM_RUNTIME_COMMAND_JSON=["prism-runtime","--json"]
PRISM_RUNTIME_TIMEOUT_SECONDS=10
HQBASE_ORIGIN=https://mail.aiaiaiai.org
# PRISM_HUB_PROVIDER_TOKEN=replace-with-strict-base64-for-32-random-bytes
PRISM_MAIL_COMMAND_JSON=["prism-mail"]
PRISM_MAIL_TIMEOUT_SECONDS=30
# Signal loop (bin/prism-hub-signal-scheduler). Sources are public Telegram channels: a
# comma-separated list, or PRISM_SIGNAL_SOURCES_JSON=[{"kind":"telegram","channel":"..."}]. One of the two.
PRISM_SIGNAL_TELEGRAM_CHANNELS=vanek_nikolaev
PRISM_SIGNAL_COLLECT_COMMAND_JSON=["prism-signal-collect"]
PRISM_SIGNAL_RUNTIME_COMMAND_JSON=["prism-signal-runtime","--json"]
PRISM_SIGNAL_TIMEOUT_SECONDS=60
PRISM_SIGNAL_INTERVAL_SECONDS=60
PRISM_SIGNAL_WINDOW_SECONDS=14400
PRISM_SIGNAL_MAX_AGE_SECONDS=1800
PRISM_SIGNAL_COOLDOWN_SECONDS=300
PRISM_SIGNAL_ALERT_CHANNEL=alerts
