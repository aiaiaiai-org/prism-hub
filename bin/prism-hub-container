#!/usr/bin/env bash
# © 2026 aiaiaiai · aiaiaiai.org
# SPDX-License-Identifier: Apache-2.0
#
# The container's one process. It prepares the database, then runs the web server, the delivery
# worker, and the signal scheduler side by side.
#
# If any of the three stops, the others are stopped and the container exits with its status, so the
# container runtime restarts the whole thing. A hub with a dead scheduler and a live web server
# would look healthy while telling nobody anything.
set -Eeuo pipefail

cd "$(dirname "$0")/.."

commands=(
  "bundle exec puma --config config/puma.rb"
  "bin/prism-hub-delivery-worker"
  "bin/prism-hub-signal-scheduler"
)

if [[ "${PRISM_HUB_SKIP_PREPARE:-false}" != "true" ]]; then
  # Migrations finish before anything serves, so no release ever runs on an older schema.
  bundle exec rails db:prepare
fi

pids=()
for command in "${commands[@]}"; do
  # shellcheck disable=SC2086 # the commands above are plain words, split on purpose
  $command &
  pids+=("$!")
done

stop() {
  kill -TERM "${pids[@]}" 2>/dev/null || true
  wait 2>/dev/null || true
}

trap 'stop; exit 143' TERM INT

status=0
wait -n || status=$?
stop
exit "$status"
