#!/usr/bin/env ruby
# © 2026 aiaiaiai · aiaiaiai.org

ENV["RAILS_ENV"] ||= "production"
require_relative "../config/environment"

begin
  origin = ENV.fetch("HQBASE_ORIGIN")
  resource = "#{origin}/api/v1"
  cipher = PrismHub::Adapters::ProviderTokenCipher.new(key_base64: ENV.fetch("PRISM_HUB_PROVIDER_TOKEN"))
  repository = PrismHub::Adapters::ActiveRecordMailCredentialRepository.new(cipher: cipher)
  oauth_gateway = PrismHub::Adapters::HqbaseDeviceOauthGateway.new(origin: origin)
  credential_resolver = PrismHub::UseCases::ResolveMailCredential.new(
    credential_repository: repository,
    oauth_gateway: oauth_gateway,
    provider: "hqbase",
    origin: origin,
    resource: resource
  )
  list_mailboxes = PrismHub::UseCases::ListMailboxes.new(
    credential_resolver: credential_resolver,
    mailbox_gateway: PrismHub::Adapters::HqbaseMailboxGateway.new(origin: origin)
  )

  exit PrismHub::Interfaces::Cli::ListMailboxes.new(list_mailboxes: list_mailboxes).call
rescue KeyError => error
  warn(JSON.generate(error: {code: "hub.configuration.missing", key: error.key}))
  exit 1
rescue PrismHub::Error => error
  warn(JSON.generate(error: {code: error.code}))
  exit 1
end
