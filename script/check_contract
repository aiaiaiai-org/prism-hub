#!/usr/bin/env ruby
# © 2026 aiaiaiai · aiaiaiai.org

require "yaml"

require_relative "../lib/prism_hub"

path = File.expand_path("../openapi/prism-hub.v1.yaml", __dir__)
contract = YAML.safe_load_file(path, aliases: false)

expected_operations = {
  ["/healthz", "get"] => "getHealth",
  ["/api/v1/actors/resolve", "post"] => "resolveActor",
  ["/api/v1/actors/onboard", "post"] => "onboardActor",
  ["/api/v1/actors/personal/resolve", "post"] => "resolvePersonalActor",
  ["/api/v1/channels", "get"] => "listChannels",
  ["/api/v1/publications/validate", "post"] => "validatePublication",
  ["/api/v1/publications", "post"] => "publishPublication"
}
protected_operations = [
  ["/api/v1/actors/resolve", "post"],
  ["/api/v1/actors/onboard", "post"],
  ["/api/v1/actors/personal/resolve", "post"],
  ["/api/v1/channels", "get"],
  ["/api/v1/publications/validate", "post"],
  ["/api/v1/publications", "post"]
].freeze

raise "OpenAPI version drift" unless contract.fetch("openapi") == "3.1.0"
raise "Hub API metadata version drift" unless contract.dig("info", "version") == "0.1.0-alpha.7"

expected_operations.each do |(route, method), operation_id|
  actual = contract.dig("paths", route, method, "operationId")
  raise "missing #{method.upcase} #{route} operation" unless actual == operation_id
end

protected_operations.each do |route, method|
  responses = contract.dig("paths", route, method, "responses")
  %w[401 403].each do |status|
    raise "#{method.upcase} #{route} must declare #{status}" unless responses.key?(status)
  end
end

actor_request = contract.dig("components", "schemas", "ActorResolutionRequest")
unless actor_request.fetch("additionalProperties") == false &&
    actor_request.fetch("required").sort == %w[provider provider_scope subject_id workspace_id] &&
    actor_request.fetch("properties").keys.sort == %w[provider provider_scope subject_id workspace_id]
  raise "actor resolution request must expose one workspace and provider subject fields"
end

actor = contract.dig("components", "schemas", "ResolvedActor")
unless actor.fetch("additionalProperties") == false &&
    actor.fetch("required").sort == %w[identity role] &&
    actor.fetch("properties").keys.sort == %w[identity role]
  raise "resolved actor must expose only canonical identity and workspace role"
end

onboarding_request = contract.dig("components", "schemas", "ActorOnboardingRequest")
unless onboarding_request.fetch("additionalProperties") == false &&
    onboarding_request.fetch("required").sort == %w[provider provider_scope subject_id] &&
    onboarding_request.fetch("properties").keys.sort == %w[provider provider_scope subject_id]
  raise "actor onboarding request must expose only provider subject fields"
end

onboarded_actor = contract.dig("components", "schemas", "OnboardedActor")
unless onboarded_actor.fetch("additionalProperties") == false &&
    onboarded_actor.fetch("required").sort == %w[identity role workspace_id] &&
    onboarded_actor.fetch("properties").keys.sort == %w[identity role workspace_id] &&
    onboarded_actor.dig("properties", "role", "const") == "owner"
  raise "onboarded actor must expose canonical identity, personal workspace, and owner role"
end

public_id = contract.dig("components", "schemas", "CanonicalIdentity", "properties", "id")
unless public_id.fetch("minLength") == 4 && public_id.fetch("maxLength") == 34 && public_id.fetch("pattern")
  raise "canonical person identity must expose the public 0x grammar"
end

target_properties = contract.dig(
  "components",
  "schemas",
  "PublicationTarget",
  "properties"
).keys.sort
unless target_properties == %w[channel_id id selection]
  raise "PublicationTarget must expose only public Hub targeting fields"
end

formats = contract.dig(
  "components",
  "schemas",
  "ContentVariant",
  "properties",
  "format",
  "enum"
)
raise "post and story formats must remain explicit" unless %w[post story].all? { formats.include?(_1) }

channel_required = contract.dig("components", "schemas", "Channel", "required")
raise "channels must declare capabilities" unless channel_required.include?("capabilities")

channel_parameters = contract.dig("paths", "/api/v1/channels", "get", "parameters")
parameter_refs = channel_parameters.map { |parameter| parameter.fetch("$ref") }
unless %w[#/components/parameters/PageCursor #/components/parameters/PageLimit].all? { |ref| parameter_refs.include?(ref) }
  raise "channel discovery must expose cursor pagination"
end

error_required = contract.dig("components", "schemas", "ErrorResponse", "required")
raise "typed HTTP errors must include request_id" unless error_required.include?("request_id")

example = contract.dig(
  "paths",
  "/api/v1/publications",
  "post",
  "requestBody",
  "content",
  "application/json",
  "examples",
  "multiTarget",
  "value"
)
draft = PrismHub::Domain::PublicationDraft.from_hash(example)
raise "multi-target example must contain two targets" unless draft.targets.length == 2

puts "OpenAPI and executable request contracts are valid"
