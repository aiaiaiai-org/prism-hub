#!/usr/bin/env bash
# © 2026 aiaiaiai · aiaiaiai.org

set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: bootstrap-production-database" >&2
  exit 64
fi

for command_name in openssl psql sudo; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "missing required command on deployment host: ${command_name}" >&2
    exit 69
  fi
done

if ! sudo -n true >/dev/null 2>&1; then
  echo "deployment user requires passwordless sudo" >&2
  exit 77
fi

if ! sudo -n -u postgres psql --no-psqlrc --dbname=postgres --tuples-only --command='SELECT 1' >/dev/null; then
  echo "local PostgreSQL is unavailable or the postgres system role cannot connect" >&2
  exit 69
fi

app_root="/srv/prism-hub"
shared_root="${app_root}/shared"
database_env_file="${shared_root}/database.env"
deploy_user="$(id -un)"
deploy_group="$(id -gn)"
db_host="127.0.0.1"
db_port="5432"
db_user="prism_hub"
db_name="prism_hub_production"

sudo install -d -m 0755 -o "$deploy_user" -g "$deploy_group" \
  "$app_root" "$shared_root"

if [[ -f "$database_env_file" ]]; then
  if [[ "$(stat -c '%a' "$database_env_file")" != "600" ]]; then
    echo "existing database environment file must have mode 0600" >&2
    exit 78
  fi

  database_env_line="$(cat "$database_env_file")"
  if [[ ! "$database_env_line" =~ ^DATABASE_URL=postgresql://prism_hub:([0-9a-f]{64})@127\.0\.0\.1:5432/prism_hub_production$ ]]; then
    echo "existing database environment file does not match the managed Prism Hub database contract" >&2
    exit 78
  fi
  db_password="${BASH_REMATCH[1]}"
else
  db_password="$(openssl rand -hex 32)"
fi

umask 077
sql_file="$(mktemp)"
env_file="$(mktemp "${shared_root}/database.env.XXXXXX")"
cleanup() {
  rm -f "$sql_file" "$env_file"
}
trap cleanup EXIT
chmod 0600 "$sql_file" "$env_file"

cat >"$sql_file" <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'prism_hub') THEN
    CREATE ROLE prism_hub LOGIN;
  END IF;
END
\$\$;

ALTER ROLE prism_hub WITH LOGIN PASSWORD '${db_password}';

SELECT 'CREATE DATABASE prism_hub_production OWNER prism_hub'
WHERE NOT EXISTS (
  SELECT 1 FROM pg_database WHERE datname = 'prism_hub_production'
)\gexec

ALTER DATABASE prism_hub_production OWNER TO prism_hub;
REVOKE ALL ON DATABASE prism_hub_production FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE prism_hub_production TO prism_hub;
SQL

sudo -n -u postgres psql \
  --no-psqlrc \
  --set=ON_ERROR_STOP=1 \
  --dbname=postgres \
  <"$sql_file" \
  >/dev/null

PGPASSWORD="$db_password" psql \
  --no-psqlrc \
  --host="$db_host" \
  --port="$db_port" \
  --username="$db_user" \
  --dbname="$db_name" \
  --set=ON_ERROR_STOP=1 \
  --tuples-only \
  --command='SELECT current_user, current_database()' \
  >/dev/null

printf 'DATABASE_URL=postgresql://%s:%s@%s:%s/%s\n' \
  "$db_user" "$db_password" "$db_host" "$db_port" "$db_name" \
  >"$env_file"
chmod 0600 "$env_file"
mv -f "$env_file" "$database_env_file"

printf 'production database is ready: %s@%s:%s/%s\n' \
  "$db_user" "$db_host" "$db_port" "$db_name"
