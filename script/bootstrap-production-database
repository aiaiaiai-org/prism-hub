#!/usr/bin/env bash
# © 2026 aiaiaiai · aiaiaiai.org

set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: bootstrap-production-database CONFIG_JSON" >&2
  exit 64
fi

config_path="$1"

for command_name in psql python3 sudo; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "missing required command on deployment host: ${command_name}" >&2
    exit 69
  fi
done

if ! sudo -n true >/dev/null 2>&1; then
  echo "deployment user requires passwordless sudo" >&2
  exit 77
fi

if [[ ! -f "$config_path" ]]; then
  echo "database bootstrap configuration is missing" >&2
  exit 66
fi

mapfile -t database_config < <(
  python3 - "$config_path" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    config = json.load(handle)

for key in ("host", "port", "user", "password", "database"):
    value = config.get(key)
    if not isinstance(value, str) or not value:
        raise SystemExit(f"database bootstrap config is missing {key}")
    if "\x00" in value or "\n" in value or "\r" in value:
        raise SystemExit(f"database bootstrap config {key} must be single-line")
    print(value)
PY
)

if [[ ${#database_config[@]} -ne 5 ]]; then
  echo "database bootstrap configuration is invalid" >&2
  exit 78
fi

db_host="${database_config[0]}"
db_port="${database_config[1]}"
db_user="${database_config[2]}"
db_password="${database_config[3]}"
db_name="${database_config[4]}"

if [[ "$db_user" != "prism_hub" || "$db_name" != "prism_hub_production" ]]; then
  echo "database bootstrap only manages prism_hub/prism_hub_production" >&2
  exit 78
fi

if [[ "$db_host" != "127.0.0.1" && "$db_host" != "localhost" && "$db_host" != "::1" ]]; then
  echo "production DATABASE_URL must target PostgreSQL on this VPS" >&2
  exit 78
fi

if [[ ! "$db_port" =~ ^[0-9]+$ ]] || (( db_port < 1 || db_port > 65535 )); then
  echo "database port is invalid" >&2
  exit 78
fi

if ! sudo -u postgres psql --no-psqlrc --dbname=postgres --tuples-only --command='SELECT 1' >/dev/null; then
  echo "local PostgreSQL is unavailable or the postgres system role cannot connect" >&2
  exit 69
fi

sql_file="$(mktemp)"
cleanup() {
  rm -f "$sql_file" "$config_path"
}
trap cleanup EXIT
chmod 0600 "$sql_file"

python3 - "$config_path" "$sql_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    config = json.load(handle)

password = config["password"]
password_literal = "'" + password.replace("'", "''") + "'"

sql = f"""
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'prism_hub') THEN
    CREATE ROLE prism_hub LOGIN;
  END IF;
END
$$;

ALTER ROLE prism_hub WITH LOGIN PASSWORD {password_literal};

SELECT 'CREATE DATABASE prism_hub_production OWNER prism_hub'
WHERE NOT EXISTS (
  SELECT 1 FROM pg_database WHERE datname = 'prism_hub_production'
)\gexec

ALTER DATABASE prism_hub_production OWNER TO prism_hub;
REVOKE ALL ON DATABASE prism_hub_production FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE prism_hub_production TO prism_hub;
"""

with open(sys.argv[2], "w", encoding="utf-8") as handle:
    handle.write(sql)
PY

sudo -u postgres psql \
  --no-psqlrc \
  --set=ON_ERROR_STOP=1 \
  --dbname=postgres \
  --file="$sql_file" \
  >/dev/null

PGPASSWORD="$db_password" psql \
  --no-psqlrc \
  --host="$db_host" \
  --port="$db_port" \
  --username="$db_user" \
  --dbname="$db_name" \
  --set=ON_ERROR_STOP=1 \
  --tuples-only \
  --command='SELECT current_user, current_database()' \
  >/dev/null

printf 'production database is ready: %s@%s:%s/%s\n' \
  "$db_user" "$db_host" "$db_port" "$db_name"
