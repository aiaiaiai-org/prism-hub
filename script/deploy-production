#!/usr/bin/env bash
# © 2026 aiaiaiai · aiaiaiai.org

set -Eeuo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: deploy-production RELEASE_SHA ARCHIVE_PATH ENV_FILE_PATH" >&2
  exit 64
fi

release_sha="$1"
archive_path="$2"
incoming_env_path="$3"

if [[ ! "$release_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "release SHA must be a full Git commit SHA" >&2
  exit 64
fi

app_name="prism-hub"
app_root="/srv/${app_name}"
releases_root="${app_root}/releases"
shared_root="${app_root}/shared"
release_dir="${releases_root}/${release_sha}"
database_env_file="${shared_root}/database.env"
env_file="${shared_root}/production.env"
current_link="${app_root}/current"
service_name="${app_name}.service"
deploy_user="$(id -un)"
deploy_group="$(id -gn)"
runtime_path="$PATH"

required_commands=(bundle curl ruby stat sudo systemctl systemd-run tar)
for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "missing required command on deployment host: ${command_name}" >&2
    exit 69
  fi
done

if ! sudo -n true >/dev/null 2>&1; then
  echo "deployment user requires passwordless sudo for service management" >&2
  exit 77
fi

ruby_version="$(ruby -e 'print RUBY_VERSION')"
if [[ "$ruby_version" != "4.0.6" ]]; then
  echo "Ruby 4.0.6 is required on the deployment host; found ${ruby_version}" >&2
  exit 69
fi

if [[ ! -f "$archive_path" || ! -f "$incoming_env_path" ]]; then
  echo "deployment archive or environment file is missing" >&2
  exit 66
fi

sudo install -d -m 0755 -o "$deploy_user" -g "$deploy_group" \
  "$app_root" "$releases_root" "$shared_root"

if [[ ! -f "$database_env_file" ]]; then
  echo "production database credentials are missing; run Bootstrap production database first" >&2
  exit 78
fi
if [[ "$(stat -c '%a' "$database_env_file")" != "600" ]]; then
  echo "production database environment file must have mode 0600" >&2
  exit 78
fi

database_env_line="$(cat "$database_env_file")"
if [[ ! "$database_env_line" =~ ^DATABASE_URL=postgresql://prism_hub:[0-9a-f]{64}@127\.0\.0\.1:5432/prism_hub_production$ ]]; then
  echo "production database environment file does not match the managed Prism Hub database contract" >&2
  exit 78
fi
if grep -q '^DATABASE_URL=' "$incoming_env_path"; then
  echo "DATABASE_URL must remain VPS-local and must not arrive from the deployment workflow" >&2
  exit 78
fi

combined_env="$(mktemp)"
cleanup_combined_env() {
  rm -f "$combined_env"
}
trap cleanup_combined_env EXIT
chmod 0600 "$combined_env"
cat "$database_env_file" "$incoming_env_path" >"$combined_env"
install -m 0600 "$combined_env" "$env_file"
rm -f "$incoming_env_path" "$combined_env"
trap - EXIT

current_release=""
if [[ -L "$current_link" ]]; then
  current_release="$(readlink -f "$current_link")"
fi

if [[ -d "$release_dir" && "$current_release" != "$release_dir" ]]; then
  rm -rf -- "$release_dir"
fi

if [[ ! -d "$release_dir" ]]; then
  mkdir -m 0755 "$release_dir"
  tar -xzf "$archive_path" -C "$release_dir"
fi
rm -f "$archive_path"

bundle_bin="$(command -v bundle)"
export BUNDLE_DEPLOYMENT="true"
export BUNDLE_PATH="${shared_root}/bundle"
export BUNDLE_WITHOUT="development:test"

(
  cd "$release_dir"
  "$bundle_bin" install --jobs 4 --retry 3
)

run_with_runtime_env() {
  local working_directory="$1"
  shift

  sudo systemd-run \
    --quiet \
    --wait \
    --collect \
    --pipe \
    --uid="$deploy_user" \
    --gid="$deploy_group" \
    --working-directory="$working_directory" \
    --property="EnvironmentFile=${env_file}" \
    --setenv="BUNDLE_DEPLOYMENT=true" \
    --setenv="BUNDLE_PATH=${shared_root}/bundle" \
    --setenv="BUNDLE_WITHOUT=development:test" \
    --setenv="PATH=${runtime_path}" \
    -- "$@"
}

run_with_runtime_env "$release_dir" "$bundle_bin" exec rails db:migrate

previous_release="$current_release"

ln -sfn "$release_dir" "${current_link}.next"
mv -Tf "${current_link}.next" "$current_link"

service_file="$(mktemp)"
cleanup() {
  rm -f "$service_file"
}
trap cleanup EXIT

cat >"$service_file" <<EOF
# © 2026 aiaiaiai · aiaiaiai.org
[Unit]
Description=Prism Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${deploy_user}
Group=${deploy_group}
WorkingDirectory=${current_link}
EnvironmentFile=${env_file}
Environment=BUNDLE_DEPLOYMENT=true
Environment=BUNDLE_PATH=${shared_root}/bundle
Environment=BUNDLE_WITHOUT=development:test
Environment="PATH=${runtime_path}"
ExecStart=${bundle_bin} exec puma -C config/puma.rb
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=${app_root}

[Install]
WantedBy=multi-user.target
EOF

sudo install -m 0644 "$service_file" "/etc/systemd/system/${service_name}"
sudo systemctl daemon-reload
sudo systemctl enable "$service_name" >/dev/null
sudo systemctl restart "$service_name"

health_url="http://127.0.0.1:3000/healthz"
healthy=false
for _attempt in $(seq 1 30); do
  if curl \
    --fail \
    --silent \
    --show-error \
    --max-time 2 \
    --header 'X-Forwarded-Proto: https' \
    "$health_url" >/dev/null; then
    healthy=true
    break
  fi
  sleep 1
done

if [[ "$healthy" != "true" ]]; then
  echo "new Prism Hub release failed the local health check" >&2
  sudo systemctl --no-pager --full status "$service_name" || true

  if [[ -n "$previous_release" && "$previous_release" != "$release_dir" && -d "$previous_release" ]]; then
    ln -sfn "$previous_release" "${current_link}.rollback"
    mv -Tf "${current_link}.rollback" "$current_link"
    sudo systemctl restart "$service_name"
    echo "rolled service pointer back to the previous release" >&2
  fi

  exit 70
fi

mapfile -t stale_releases < <(
  find "$releases_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
    | sort -nr \
    | tail -n +6 \
    | cut -d' ' -f2-
)
for stale_release in "${stale_releases[@]}"; do
  [[ "$stale_release" == "$release_dir" ]] && continue
  [[ -n "$previous_release" && "$stale_release" == "$previous_release" ]] && continue
  rm -rf -- "$stale_release"
done

printf 'deployed prism-hub %s\n' "$release_sha"
